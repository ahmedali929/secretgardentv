---
import GardenPage from '../layouts/GardenPage.astro';
import Container from '../components/garden/Container.astro';
import Button from '../components/garden/Button.astro';

const page = {
  title: 'Page not found | Secret Garden TV for Kids',
  description: 'The page you requested may have moved.',
  canonicalPath: '/404.html',
  type: 'website',
};
---
<GardenPage {page} heading="Page not found" intro={page.description} hideFromSearch>
  <section class="garden-section">
    <Container><Button href="/">Return to Secret Garden TV</Button></Container>
  </section>
</GardenPage>
