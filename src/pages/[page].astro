---
import LegacyPage from '../layouts/LegacyPage.astro';
import { legacyPages } from '../content/pages.mjs';
import { readLegacyPage } from '../content/read-legacy-page.mjs';

export function getStaticPaths() {
  return Object.keys(legacyPages)
    .filter((slug) => slug !== 'index')
    .map((slug) => ({ params: { page: slug }, props: readLegacyPage(slug) }));
}
---
<LegacyPage {...Astro.props} />
